# 换行符按用途固定，避免 Windows 检出把脚本改成 CRLF 后在 Linux 上跑不了
*.sh        text eol=lf
*.tpl       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.yml       text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制，不做换行转换
*.png       binary
*.jpg       binary
*.pdf       binary
*.docx      binary
*.doc       binary
