[Unit]
Description=DeepSeek model proxy (holds the real API key)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/road-chat/proxy.env
ExecStart=/usr/bin/python3 -X utf8 /srv/road/app/scripts/p3/proxy/model_proxy.py --port 8096 --upstream https://api.deepseek.com/anthropic --usage-log /var/log/road-chat/usage.log
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/log/road-chat

[Install]
WantedBy=multi-user.target
